    {
      "parameters": {
        "jsCode": "const item = $input.item.json;\n\n// Today's date in Lagos time as YYYYMMDD\nconst datePart = new Date()\n  .toLocaleDateString('en-CA', { timeZone: 'Africa/Lagos' })\n  .replace(/-/g, '');\n\n// Four random digits, keeping any leading zeros\nconst rand = String(Math.floor(Math.random() * 10000)).padStart(4, '0');\n\nreturn {\n  json: {\n    ...item,\n    ticket_id: `TCK-${datePart}-${rand}`\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        32
      ],
      "id": "b908350e-62c8-41c8-825a-b70813751cd7",
