        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 3
                },
                "conditions": [
                  {
                    "leftValue": "={{ /\\b(invoice|refund|payment|receipt|charged|subscription)/i.test($json.search_text) }}",
                    "rightValue": "=/\\b(invoice|refund|payment|receipt|charged|subscription)/i",
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    },
                    "id": "80e13541-668f-432e-8270-0e2fa4cd7b05"
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Billing"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 3
                },
                "conditions": [
                  {
                    "id": "46206213-d619-43e3-b184-840cd09ee674",
                    "leftValue": "={{ /\\b(broken|error|not\\s+working|crash|login|password|faulty|screen)/i.test($json.search_text) }}",
                    "rightValue": "=/\\b(broken|error|not\\s+working|crash|login|password|faulty|screen)/i\t",
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
