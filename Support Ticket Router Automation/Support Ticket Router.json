                    "rightValue": "=/\\b(price|pricing|quote|buy|order|demo|how\\s+much|availability)/i",
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
