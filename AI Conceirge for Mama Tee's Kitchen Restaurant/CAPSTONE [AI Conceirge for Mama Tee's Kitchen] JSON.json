      "name": "Webhook",
      "webhookId": "57fafc6d-6ae0-48a1-8e50-fe1ddfef550b"
    },
    {
      "parameters": {
        "jsCode": "const webhookData = $input.all()[0].json;\n\n// Data is inside body.message.toolCalls[0].function.arguments\nconst args = webhookData.body.message.toolCalls[0].function.arguments;\n\n// Get core customer data\nconst customer_name = (args[\"customer_name \"] || args[\"customer_name\"] || \"Unknown\").trim();\nconst phone_number = (args.phone_number || \"Unknown\").trim();\nconst request_type = (args.request_type || \"callback\").toLowerCase().trim();\nconst details = (args.details || \"No details provided\").trim();\n\n// Nigerian time now\nconst now = new Date();\nconst timeOptions = {\n  timeZone: \"Africa/Lagos\",\n  hour: \"2-digit\",\n  minute: \"2-digit\",\n  hour12: true\n};\n\n// ================================\n// INITIALIZE ALL VARIABLES\n// ================================\nlet estimated_delivery_time = \"N/A\";\nlet payment_method = \"N/A\";\nlet reservation_date = \"N/A\";\nlet reservation_time = \"N/A\";\nlet number_of_people = \"N/A\";\nlet reservation_deposit = \"N/A\";\nlet callback_reason = \"N/A\";\nlet callback_priority = \"N/A\";\n\n// ================================\n// ORDER LOGIC\n// ================================\nif (request_type === \"order\") {\n\n  // Delivery window 30-60 mins from now\n  const deliveryStart = new Date(now.getTime() + 30 * 60000);\n  const deliveryEnd = new Date(now.getTime() + 60 * 60000);\n  estimated_delivery_time = `Between ${deliveryStart.toLocaleTimeString(\"en-NG\", timeOptions)} and ${deliveryEnd.toLocaleTimeString(\"en-NG\", timeOptions)}`;\n\n  // Payment for orders\n  payment_method = \"Cash or GTBank Transfer — Account Name: Mama Tee's Kitchen | Account Number: 0123456789 | Payment must be made before dispatch\";\n\n}\n\n// ================================\n// RESERVATION LOGIC\n// ================================\nelse if (request_type === \"reservation\") {\n\n  // Extract number of people FIRST before date\n  // to avoid date regex grabbing people count\n  const peopleMatch = details.match(\n    /\\b(\\d+)\\s*(?:people|persons|guests|pax|guest)\\b/i\n  );\n  number_of_people = peopleMatch\n    ? peopleMatch[1] + \" people\"\n    : (args.number_of_people || \"Check details field\");\n\n  // Remove the people number from details\n  // before extracting date so it doesnt interfere\n  const detailsForDate = details\n    .replace(/\\b\\d+\\s*(?:people|persons|guests|pax|guest)\\b/gi, \"\")\n    .replace(/\\bfor\\s+\\d+\\b/gi, \"\")\n    .trim();\n\n  // Extract date - looks for patterns like:\n  // 30th May, May 30th, 30/05, 30-05-2026\n  // Saturday 24th, next Friday etc\n  const dateMatch = detailsForDate.match(\n    /\\b(\\d{1,2}(?:st|nd|rd|th)?\\s+(?:January|February|March|April|May|June|July|August|September|October|November|December)|(?:January|February|March|April|May|June|July|August|September|October|November|December)\\s+\\d{1,2}(?:st|nd|rd|th)?|\\d{1,2}[\\/\\-]\\d{1,2}(?:[\\/\\-]\\d{2,4})?|(?:Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday)\\s+\\d{1,2}(?:st|nd|rd|th)?|\\d{1,2}(?:st|nd|rd|th)\\s+of\\s+\\w+)\\b/i\n  );\n  reservation_date = dateMatch\n    ? dateMatch[0]\n    : (args.reservation_date || \"Check details field\");\n\n  // Extract time - looks for patterns like:\n  // 2pm, 2:00pm, 14:00, 2 PM\n  const timeMatch = details.match(\n    /\\b(\\d{1,2}(?::\\d{2})?\\s*(?:am|pm|AM|PM)|(?:\\d{2}:\\d{2}))\\b/i\n  );\n  reservation_time = timeMatch\n    ? timeMatch[0]\n    : (args.reservation_time || \"Check details field\");\n\n  // Payment for reservations\n  payment_method = \"Deposit of N5,000 required — GTBank Transfer | Account Name: Mama Tee's Kitchen | Account Number: 0123456789\";\n  reservation_deposit = \"N5,000 (goes toward total bill)\";\n\n}\n\n// ================================\n// CALLBACK LOGIC\n// ================================\nelse if (request_type === \"callback\") {\n\n  // Extract reason from details\n  callback_reason = details || \"Customer did not specify reason\";\n\n  // Set priority based on keywords in details\n  const detailsLower = details.toLowerCase();\n  const urgentKeywords = [\"urgent\", \"emergency\", \"immediately\", \"now\", \"asap\"];\n  const highKeywords = [\"complaint\", \"problem\", \"issue\", \"wrong\", \"error\", \"bad\", \"angry\", \"unhappy\", \"refund\"];\n  const lowKeywords = [\"enquiry\", \"inquiry\", \"just asking\", \"curious\", \"wondering\", \"information\"];\n\n  if (urgentKeywords.some(word => detailsLower.includes(word))) {\n    callback_priority = \"🔴 Urgent\";\n  } else if (highKeywords.some(word => detailsLower.includes(word))) {\n    callback_priority = \"🟠 High\";\n  } else if (lowKeywords.some(word => detailsLower.includes(word))) {\n    callback_priority = \"🟢 Low\";\n  } else {\n    callback_priority = \"🟡 Normal\";\n  }\n\n  payment_method = \"N/A — Callback request\";\n\n}\n\n// ================================\n// RETURN ALL DATA\n// ================================\nreturn [{\n  json: {\n    customer_name,\n    phone_number,\n    request_type,\n    details,\n    estimated_delivery_time,\n    payment_method,\n    reservation_date,\n    reservation_time,\n    number_of_people,\n    reservation_deposit,\n    callback_reason,\n    callback_priority,\n    timestamp: new Date().toLocaleString(\"en-NG\", {\n      timeZone: \"Africa/Lagos\",\n      dateStyle: \"full\",\n      timeStyle: \"short\"\n    })\n  }\n}];"
      },
